# ───────────────────────────────────────────────────────────
# Menu360 Frontend · .gitignore
# ───────────────────────────────────────────────────────────

# ─── Secretos y entorno ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# ─── Dependencias ──────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
jspm_packages/
web_modules/

# El lockfile SÍ se versiona: garantiza builds reproducibles.
# !package-lock.json

# ─── Next.js ───────────────────────────────────────────────
/.next/
/out/
.next/
next-env.d.ts
.vercel
*.tsbuildinfo

# ─── Build y distribución ──────────────────────────────────
/build
/dist
.turbo/
.swc/

# ─── Tests y cobertura ─────────────────────────────────────
/coverage
.nyc_output/
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/
__snapshots__/*.snap.new
vitest.config.ts.timestamp-*

# ─── Herramientas de calidad ───────────────────────────────
.eslintcache
.stylelintcache
.prettiercache

# ─── Análisis de bundle ────────────────────────────────────
.next/analyze/
analyze/
bundle-stats.json
stats.json
.lighthouseci/

# ─── Assets 3D pesados ─────────────────────────────────────
# Los modelos de producción viven en la CDN, no en el repositorio.
# Solo se versionan los .glb de demostración de public/models/.
*.glb
*.gltf
*.fbx
*.obj
*.blend
*.blend[0-9]*
!public/models/*.glb
*.hdr
*.exr
!public/hdri/*.hdr

# ─── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
logs/
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ─── Docker ────────────────────────────────────────────────
docker-compose.override.yml
.docker/

# ─── VS Code ───────────────────────────────────────────────
.vscode/*
!.vscode/settings.json.example
!.vscode/extensions.json
!.vscode/launch.json.example
*.code-workspace
.history/

# ─── JetBrains (WebStorm) ──────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
out/

# ─── Sistema operativo ─────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ─── Temporales y editores ─────────────────────────────────
*.swp
*.swo
*.swn
*~
*.bak
*.tmp
*.temp
*.orig
*.rej
.\#*
\#*\#
.vim/
tags
TAGS

# ─── Caché de herramientas ─────────────────────────────────
.cache/
.parcel-cache/
.temp/
.tmp/
.npm/
.node_repl_history
*.tgz
.yarn-integrity
